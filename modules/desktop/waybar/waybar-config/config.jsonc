{
  "layer": "top", // Waybar at top layer
  "position": "top", // Waybar position (top|bottom|left|right)
  "height": 32, // Waybar height (to be removed for auto height)
  "width": 1480, // Waybar width
  "spacing": 8, // Gaps between modules (4px)
  "margin-top": 8,
  "margin-left": 8,
  "margin-right": 8,
  "mode": "dock",
  "reload_style_on_change": true,
  "include": [
    "~/.config/waybar/modules.json",
    "~/.config/waybar/quicklinks.json",
    "~/.config/waybar/hardware.json",
    "~/.config/waybar/media.json",
    "~/.config/waybar/media.json"
  ],
  "modules-left": [
    "custom/exit",
    //"custom/appmenu",
    //"group/quicklinks",
    "hyprland/workspaces",
    "custom/weather"
  ],
  "modules-center": [
   
  ],
  "modules-right": [
    "network",
    // "mpd",
    "group/media",
    //"group/hardware",
    "tray",
    "clock",
    "custom/notification"
  ]
}
